# ===== DATABASE =====
# PostgreSQL connection URL | URL de conexión PostgreSQL
DATABASE_URL=postgresql://postgres:changeMe123!@postgres:5432/snake_game

# ===== APPLICATION =====
# Node environment: 'development', 'production', 'test' | Entorno de Node
NODE_ENV=production

# Application host binding | Host al que se vincula la aplicación
SERVER_HOST=0.0.0.0

# Application port | Puerto de la aplicación
SERVER_PORT=3000

# WebSocket path | Ruta de WebSocket
WS_PATH=/ws

# ===== RESOURCE PROFILE =====
# Resource profile: 'auto' (detects), 'low' (1vCPU/1GB), 'standard' (2vCPU/2GB), 'high' (4vCPU/8GB)
# Perfil de recursos: 'auto' (detecta), 'low' (1vCPU/1GB), 'standard' (2vCPU/2GB), 'high' (4vCPU/8GB)
RESOURCE_PROFILE=auto

# Max app heap memory in MB | Memoria máxima del heap de la app en MB
NODE_HEAP_MB=256

# App container memory limit in MB | Límite de memoria del contenedor en MB
APP_MEM_LIMIT=448m

# Database container memory limit in MB | Límite de memoria de la BD en MB
DB_MEM_LIMIT=256m

# ===== GAME SETTINGS =====
# Game tick rate in Hz (lower = less CPU) | Tasa de tick del juego en Hz (menor = menos CPU)
# TICK_HZ=20

# Target room capacity | Capacidad objetivo de sala
# ROOM_CAPACITY=20

# Maximum rooms | Máximo de salas
# MAX_ROOMS=6

# Enable bots | Habilitar bots
BOT_ENABLE=true

# Minimum bots per room when below player threshold | Bots mínimos por sala
# BOT_MIN_PER_ROOM=8

# Arena width in pixels | Ancho de arena en píxeles
# ARENA_WIDTH=4000

# Arena height in pixels | Alto de arena en píxeles
# ARENA_HEIGHT=4000

# ===== BOOST & REVIVAL =====
# Boost mass consumption per tick | Consumo de masa por tick al acelerar
BOOST_CONSUMPTION=1

# Minimum snake length to boost | Longitud mínima de serpiente para acelerar
BOOST_MIN_LENGTH=4

# Revival protection duration in seconds | Duración de protección al revivir en segundos
REVIVAL_PROTECTION_DURATION=3

# Revival mass restore percentage (0-100) | Porcentaje de masa a restaurar al revivir
REVIVAL_RESTORE_PERCENT=50

# Max revivals per run | Máximo de revives por partida
REVIVAL_MAX_PER_RUN=1

# Revival claim expiration in seconds | Expiración de reclamación de revive en segundos
REVIVAL_CLAIM_EXPIRY=300

# ===== ADMIN AUTHENTICATION =====
# REQUIRED to create the first admin account at /admin (only used when no admin exists yet)
# OBLIGATORIO para crear la primera cuenta de administrador en /admin (solo si aún no existe ninguna)
ADMIN_BOOTSTRAP_EMAIL=

# Use a long, unique password. You can change it later in /admin → Account
# Usa una contraseña larga y única. Puedes cambiarla después en /admin → Cuenta
ADMIN_BOOTSTRAP_PASSWORD=

# Admin login rate limit: max attempts per window | Límite de intentos de login
ADMIN_RATE_LIMIT_ATTEMPTS=5

# Admin login rate limit window in seconds | Ventana de límite de intentos en segundos
ADMIN_RATE_LIMIT_WINDOW=300

# ===== ADVERTISING (Monetag) =====
# Enable advertising | Habilitar publicidad
AD_ENABLE=false

# Monetag SDK script URL (paste snippet from Monetag dashboard) | URL del script de Monetag
AD_MONETAG_SCRIPT_URL=

# Rewarded ad zone ID | ID de zona de anuncio con recompensa
AD_REWARD_ZONE_ID=

# Ad frequency cap: max ads per day per player | Máximo de anuncios por día por jugador
AD_FREQUENCY_CAP_DAILY=3

# ===== LOGGING =====
# Log level: 'trace', 'debug', 'info', 'warn', 'error', 'fatal' | Nivel de log
LOG_LEVEL=info

# ===== METRICS & ANALYTICS =====
# Metrics sampling interval in seconds (lower = more frequent) | Intervalo de muestreo en segundos
METRICS_SAMPLE_INTERVAL=15

# Event retention policy in days | Retención de eventos en días
EVENT_RETENTION_DAYS=30

# ===== DOCKER & NETWORKING =====
# Docker network name (used in compose) | Nombre de la red de Docker
DOCKER_NETWORK=snake-network

# PostgreSQL host (service name in compose) | Host de PostgreSQL (nombre del servicio)
DB_HOST=postgres

# PostgreSQL port (internal) | Puerto de PostgreSQL (interno)
DB_PORT=5432

# PostgreSQL database name | Nombre de la base de datos
DB_NAME=snake_game

# PostgreSQL user | Usuario de PostgreSQL
DB_USER=postgres

# PostgreSQL password | Contraseña de PostgreSQL
DB_PASSWORD=changeMe123!

# ===== SSL/TLS (for Dokploy/Traefik) =====
# SSL enabled (false for local, true for production with proxy) | SSL habilitado
SSL_ENABLED=false

# Public URL of the site, used for SEO links (canonical, hreflang, sitemap) | URL pública del sitio, usada para SEO
# Example | Ejemplo: https://snake.example.com
SITE_URL=

# ===== DOCKER COMPOSE OVERRIDES =====
# Optional: set individual tick rate, room size, etc. to override profile defaults
# Opcional: establece valores individuales para sobrescribir los del perfil
# TICK_HZ=15
# ROOM_CAPACITY=12
# BOT_MIN_PER_ROOM=4
